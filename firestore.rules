rules_version = '2';
// users/{uid}: accountId (immutable string 3..24), createdAt (timestamp).
// progress/game, progress/quests, meals: existing bounded schemas; profile = UID.
// roles/{uid}: admin (boolean), console/Admin SDK writes only, self get only.
// families/{fid}: createdBy UID, createdAt timestamp; members keyed by UID.
// messages: senderUid, senderId, text, cardId, createdAt; append-only.
// UID-era documents remain readable; old shared progress is denied, not deleted.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function accountOwner(uid) {
      return signedIn() && request.auth.uid == uid &&
        request.auth.token.email is string &&
        request.auth.token.email.matches('^[a-z0-9_]{3,24}@id[.]mogumogu[.]invalid$');
    }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/roles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.admin == true;
    }
    function hasAccount(uid) {
      return accountOwner(uid) && exists(/databases/$(database)/documents/users/$(uid)) &&
        (request.auth.token.email != 'admin@id.mogumogu.invalid' || isAdmin());
    }
    function personalOwner(uid) { return hasAccount(uid) && !isAdmin(); }
    function isMember(fid) {
      return personalOwner(request.auth.uid) &&
        exists(/databases/$(database)/documents/families/$(fid)/members/$(request.auth.uid));
    }
    function validMeal(mealId) {
      return request.resource.data.keys().hasAll([
        'id', 'profile', 'date', 'mealType', 'durationSec', 'source',
        'startAt', 'endAt', 'createdAt', 'updatedAt'
      ]) &&
      request.resource.data.keys().hasOnly([
        'id', 'profile', 'date', 'mealType', 'durationSec', 'source',
        'startAt', 'endAt', 'createdAt', 'updatedAt', 'foodNote', 'mealTime'
      ]) &&
      request.resource.data.id == mealId &&
      request.resource.data.id is string &&
      request.resource.data.id.size() <= 100 &&
      request.resource.data.profile == request.auth.uid &&
      request.resource.data.date is string &&
      request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
      request.resource.data.mealType in ['breakfast', 'lunch', 'dinner', 'snack'] &&
      request.resource.data.durationSec is int &&
      request.resource.data.durationSec >= 0 &&
      request.resource.data.durationSec <= 86400 &&
      (request.resource.data.mealType == 'snack' || request.resource.data.durationSec > 0) &&
      request.resource.data.source in ['timer', 'manual'] &&
      (request.resource.data.startAt == null || request.resource.data.startAt is string && request.resource.data.startAt.size() <= 40) &&
      (request.resource.data.endAt == null || request.resource.data.endAt is string && request.resource.data.endAt.size() <= 40) &&
      (!('foodNote' in request.resource.data) ||
        request.resource.data.foodNote is string && request.resource.data.foodNote.size() <= 200) &&
      (!('mealTime' in request.resource.data) ||
        request.resource.data.mealTime is string &&
        request.resource.data.mealTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')) &&
      request.resource.data.createdAt is string && request.resource.data.createdAt.size() <= 40 &&
      request.resource.data.updatedAt is string && request.resource.data.updatedAt.size() <= 40;
    }


    // The legacy wire field `profile` now contains the UID.
    function validAdventure(gameProfile) {
      let d=request.resource.data;
      return d.keys().hasAll(['profile','version','tasks','days','rewards','updatedAt']) &&
        d.keys().hasOnly(['profile','version','tasks','days','rewards','updatedAt']) &&
        d.profile == gameProfile && d.version == 1 &&
        d.tasks is map && d.tasks.size() <= 50 &&
        d.days is map && d.days.size() <= 400 &&
        d.rewards is map && d.rewards.size() <= 5000 && d.updatedAt is string && d.updatedAt.size() <= 40;
    }
    function validGame(gameProfile) {
      return request.resource.data.keys().hasAll([
            'profile','version','coins','tickets','drawCount',
            'lastFreeDay','lastLoginDay','loginDays','inventory','history',
            'mealRewardDays','streakRewardKeys','updatedAt'
          ]) &&
          request.resource.data.keys().hasOnly([
            'profile','version','coins','tickets','drawCount',
            'lastFreeDay','lastLoginDay','loginDays','inventory','history',
            'mealRewardDays','streakRewardKeys','updatedAt'
          ]) &&
          request.resource.data.profile == gameProfile &&
          request.resource.data.version == 1 &&
          request.resource.data.coins is int &&
          request.resource.data.coins >= 0 && request.resource.data.coins <= 2147483647 &&
          request.resource.data.tickets is int &&
          request.resource.data.tickets >= 0 && request.resource.data.tickets <= 2147483647 &&
          request.resource.data.drawCount is int &&
          request.resource.data.drawCount >= 0 && request.resource.data.drawCount <= 2147483647 &&
          request.resource.data.lastFreeDay is string && request.resource.data.lastFreeDay.size() <= 10 &&
          request.resource.data.lastLoginDay is string && request.resource.data.lastLoginDay.size() <= 10 &&
          request.resource.data.loginDays is int &&
          request.resource.data.loginDays >= 0 &&
          request.resource.data.inventory is map && request.resource.data.inventory.size() <= 100 &&
          request.resource.data.history is list &&
          request.resource.data.history.size() <= 30 &&
          request.resource.data.mealRewardDays is map && request.resource.data.mealRewardDays.size() <= 5000 &&
          request.resource.data.streakRewardKeys is list && request.resource.data.streakRewardKeys.size() <= 5000 &&
          request.resource.data.updatedAt is string && request.resource.data.updatedAt.size() <= 40;
    }

    function validAccount() {
      let d=request.resource.data;
      return d.keys().hasAll(['accountId','createdAt']) && d.keys().hasOnly(['accountId','createdAt']) &&
        d.accountId is string && d.accountId.matches('^[a-z0-9_]{3,24}$') &&
        request.auth.token.email == d.accountId + '@id.mogumogu.invalid' && d.createdAt == request.time &&
        (d.accountId != 'admin' || isAdmin());
    }
    function validGroup(fid) {
      let d=request.resource.data;
      return fid.matches('^[A-Za-z0-9_-]{24}$') && isMember(fid) &&
        d.keys().hasAll(['name']) && d.keys().hasOnly(['name']) &&
        d.name is string && d.name.size() > 0 && d.name.size() <= 30;
    }
    match /roles/{uid} {
      allow get: if accountOwner(uid);
      allow list, create, update, delete: if false;
    }
    match /users/{uid} {
      allow get: if accountOwner(uid);
      allow create: if accountOwner(uid) && validAccount();
      allow list, update, delete: if false;
      match /progress/{name} {
        allow get: if personalOwner(uid) && name in ['game','quests'];
        allow create, update: if personalOwner(uid) &&
          ((name == 'game' && validGame(uid)) || (name == 'quests' && validAdventure(uid)));
        allow list, delete: if false;
      }
      match /meals/{mealId} {
        allow get, list, delete: if personalOwner(uid);
        allow create: if personalOwner(uid) && validMeal(mealId);
        // UID-scoped legacy records may be normalized; creation time stays fixed.
        allow update: if personalOwner(uid) && validMeal(mealId) &&
          request.resource.data.createdAt == resource.data.createdAt;
      }
      match /groups/{fid} {
        allow get, list: if personalOwner(uid);
        allow create, update: if personalOwner(uid) && validGroup(fid);
        allow delete: if false;
      }
    }
    function validMessage() {
      let d=request.resource.data;
      return d.keys().hasAll(['senderUid','senderId','text','cardId','createdAt']) &&
        d.keys().hasOnly(['senderUid','senderId','text','cardId','createdAt']) &&
        d.senderUid == request.auth.uid &&
        d.senderId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountId &&
        d.text is string && d.text.size() > 0 && d.text.size() <= 500 &&
        d.cardId is string && d.cardId.size() <= 100 && d.createdAt == request.time &&
        (d.cardId == '' ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)/progress/game) &&
           d.cardId in get(/databases/$(database)/documents/users/$(request.auth.uid)/progress/game).data.inventory &&
           get(/databases/$(database)/documents/users/$(request.auth.uid)/progress/game).data.inventory[d.cardId].copies > 0));
    }
    function validReaction(fid,messageId) {
      return !messageId.matches('^_like_.*') ||
        (messageId.matches('^_like_[A-Za-z0-9]{20}_'+request.auth.uid+'$') &&
         request.resource.data.text == '__mogumogu_like_v1__' && request.resource.data.cardId == '' &&
         exists(/databases/$(database)/documents/families/$(fid)/messages/$(messageId.split('_')[2])));
    }
    function validFamily(fid) {
      let d=request.resource.data;
      return fid.matches('^[A-Za-z0-9_-]{24}$') &&
        d.keys().hasAll(['createdBy','createdAt']) && d.keys().hasOnly(['createdBy','createdAt']) &&
        d.createdBy == request.auth.uid && d.createdAt == request.time;
    }
    function validMember(uid) {
      let d=request.resource.data;
      return d.keys().hasAll(['uid','joinedAt']) && d.keys().hasOnly(['uid','joinedAt']) &&
        d.uid == uid && d.joinedAt == request.time;
    }
    match /families/{fid} {
      allow create: if personalOwner(request.auth.uid) && validFamily(fid);
      allow get: if isMember(fid);
      allow list, update, delete: if false;
      match /members/{uid} {
        allow get: if personalOwner(uid);
        allow create: if personalOwner(uid) && validMember(uid) &&
          exists(/databases/$(database)/documents/families/$(fid));
        allow list, update, delete: if false;
      }
      match /messages/{messageId} {
        allow get: if isMember(fid);
        allow list: if isMember(fid) && request.query.limit != null && request.query.limit <= 100;
        allow create: if isMember(fid) && validMessage() && validReaction(fid,messageId);
        allow update, delete: if false;
      }
    }
  }
}
