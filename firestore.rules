rules_version = '2';
// users/{uid}: accountId (immutable string 3..24), createdAt (timestamp).
// progress/game, progress/quests, meals: existing bounded schemas; profile = UID.
// families/{fid}: createdBy UID, createdAt timestamp; members keyed by UID.
// messages: senderUid, senderId, text, cardId, createdAt; append-only.
// UID-era documents remain readable; old shared progress is denied, not deleted.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function accountOwner(uid) {
      return signedIn() && request.auth.uid == uid &&
        request.auth.token.email is string &&
        request.auth.token.email.matches('^[a-z0-9_]{3,24}@id[.]mogumogu[.]invalid$');
    }
    function hasAccount(uid) {
      return accountOwner(uid) && exists(/databases/$(database)/documents/users/$(uid));
    }
    function isMember(fid) {
      return hasAccount(request.auth.uid) &&
        exists(/databases/$(database)/documents/families/$(fid)/members/$(request.auth.uid));
    }
    function validMeal(mealId) {
      return request.resource.data.keys().hasAll([
        'id', 'profile', 'date', 'mealType', 'durationSec', 'source',
        'startAt', 'endAt', 'createdAt', 'updatedAt'
      ]) &&
      request.resource.data.keys().hasOnly([
        'id', 'profile', 'date', 'mealType', 'durationSec', 'source',
        'startAt', 'endAt', 'createdAt', 'updatedAt', 'foodNote', 'mealTime'
      ]) &&
      request.resource.data.id == mealId &&
      request.resource.data.id is string &&
      request.resource.data.id.size() <= 100 &&
      request.resource.data.profile == request.auth.uid &&
      request.resource.data.date is string &&
      request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
      request.resource.data.mealType in ['breakfast', 'lunch', 'dinner', 'snack'] &&
      request.resource.data.durationSec is int &&
      request.resource.data.durationSec >= 0 &&
      request.resource.data.durationSec <= 86400 &&
      (request.resource.data.mealType == 'snack' || request.resource.data.durationSec > 0) &&
      request.resource.data.source in ['timer', 'manual'] &&
      (request.resource.data.startAt == null || request.resource.data.startAt is string && request.resource.data.startAt.size() <= 40) &&
      (request.resource.data.endAt == null || request.resource.data.endAt is string && request.resource.data.endAt.size() <= 40) &&
      (!('foodNote' in request.resource.data) ||
        request.resource.data.foodNote is string && request.resource.data.foodNote.size() <= 200) &&
      (!('mealTime' in request.resource.data) ||
        request.resource.data.mealTime is string &&
        request.resource.data.mealTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')) &&
      request.resource.data.createdAt is string && request.resource.data.createdAt.size() <= 40 &&
      request.resource.data.updatedAt is string && request.resource.data.updatedAt.size() <= 40;
    }


    // The legacy wire field `profile` now contains the UID.
    function validAdventure(gameProfile) {
      let d=request.resource.data;
      return d.keys().hasAll(['profile','version','tasks','days','rewards','updatedAt']) &&
        d.keys().hasOnly(['profile','version','tasks','days','rewards','values','deletedTasks','rewardEvents','valueMeta','freezeDays','updatedAt']) &&
        d.profile == gameProfile && d.version == 1 &&
        d.tasks is map && d.tasks.size() <= 500 &&
        d.days is map && d.days.size() <= 5000 &&
        d.rewards is map && d.rewards.size() <= 5000 &&
        (!('values' in d) || d.values is map && d.values.size() <= 5000) &&
        (!('deletedTasks' in d) || d.deletedTasks is map && d.deletedTasks.size() <= 5000) &&
        (!('rewardEvents' in d) || d.rewardEvents is map && d.rewardEvents.size() <= 5000) &&
        (!('valueMeta' in d) || d.valueMeta is map && d.valueMeta.size() <= 5000) &&
        (!('freezeDays' in d) || d.freezeDays is map && d.freezeDays.size() <= 5000) &&
        d.updatedAt is string && d.updatedAt.size() <= 40;
    }
    function validGame(gameProfile) {
      return request.resource.data.keys().hasAll([
            'profile','version','coins','tickets','drawCount',
            'lastFreeDay','lastLoginDay','loginDays','inventory','history',
            'mealRewardDays','streakRewardKeys','pendingCoins','pendingTickets','freezeTickets','updatedAt'
          ]) &&
          request.resource.data.keys().hasOnly([
            'profile','version','coins','tickets','drawCount',
            'lastFreeDay','lastLoginDay','loginDays','inventory','history',
            'mealRewardDays','streakRewardKeys','pendingCoins','pendingTickets','freezeTickets','updatedAt'
          ]) &&
          request.resource.data.profile == gameProfile &&
          request.resource.data.version == 1 &&
          request.resource.data.coins is int &&
          request.resource.data.coins >= 0 && request.resource.data.coins <= 2147483647 &&
          request.resource.data.tickets is int &&
          request.resource.data.tickets >= 0 && request.resource.data.tickets <= 2147483647 &&
          (!('pendingCoins' in request.resource.data) || request.resource.data.pendingCoins is int && request.resource.data.pendingCoins >= 0 && request.resource.data.pendingCoins <= 2147483647) &&
          (!('pendingTickets' in request.resource.data) || request.resource.data.pendingTickets is int && request.resource.data.pendingTickets >= 0 && request.resource.data.pendingTickets <= 2147483647) &&
          (!('freezeTickets' in request.resource.data) || request.resource.data.freezeTickets is int && request.resource.data.freezeTickets >= 0 && request.resource.data.freezeTickets <= 2147483647) &&
          request.resource.data.drawCount is int &&
          request.resource.data.drawCount >= 0 && request.resource.data.drawCount <= 2147483647 &&
          request.resource.data.lastFreeDay is string && request.resource.data.lastFreeDay.size() <= 10 &&
          request.resource.data.lastLoginDay is string && request.resource.data.lastLoginDay.size() <= 10 &&
          request.resource.data.loginDays is int &&
          request.resource.data.loginDays >= 0 &&
          request.resource.data.inventory is map && request.resource.data.inventory.size() <= 100 &&
          request.resource.data.history is list &&
          request.resource.data.history.size() <= 30 &&
          request.resource.data.mealRewardDays is map && request.resource.data.mealRewardDays.size() <= 5000 &&
          request.resource.data.streakRewardKeys is list && request.resource.data.streakRewardKeys.size() <= 5000 &&
          request.resource.data.updatedAt is string && request.resource.data.updatedAt.size() <= 40;
    }

    function validAccount() {
      let d=request.resource.data;
      return d.keys().hasAll(['accountId','createdAt']) && d.keys().hasOnly(['accountId','createdAt']) &&
        d.accountId is string && d.accountId.matches('^[a-z0-9_]{3,24}$') &&
        request.auth.token.email == d.accountId + '@id.mogumogu.invalid' && d.createdAt == request.time;
    }
    function validGroup(fid) {
      let d=request.resource.data;
      return fid.matches('^[A-Za-z0-9_-]{24}$') && isMember(fid) &&
        d.keys().hasAll(['name']) && d.keys().hasOnly(['name','alias']) &&
        d.name is string && d.name.size() > 0 && d.name.size() <= 30 &&
        (!('alias' in d) || d.alias is string && d.alias.size() <= 30);
    }
    match /users/{uid} {
      allow get: if accountOwner(uid);
      allow create: if accountOwner(uid) && validAccount();
      allow list, update, delete: if false;
      match /progress/{name} {
        allow get: if hasAccount(uid) && name in ['game','quests'];
        allow create, update: if hasAccount(uid) &&
          ((name == 'game' && validGame(uid)) || (name == 'quests' && validAdventure(uid)));
        allow list, delete: if false;
      }
      match /meals/{mealId} {
        allow get, list, delete: if hasAccount(uid);
        allow create: if hasAccount(uid) && validMeal(mealId);
        // UID-scoped legacy records may be normalized; creation time stays fixed.
        allow update: if hasAccount(uid) && validMeal(mealId) &&
          request.resource.data.createdAt == resource.data.createdAt;
      }
      match /groups/{fid} {
        allow get, list: if hasAccount(uid);
        allow create, update: if hasAccount(uid) && validGroup(fid);
        allow delete: if hasAccount(uid);
      }
      match /activity/{day} {
        allow get: if hasAccount(uid) ||
          (signedIn() && (exists(/databases/$(database)/documents/friendships/$(uid+'--'+request.auth.uid)) ||
            exists(/databases/$(database)/documents/friendships/$(request.auth.uid+'--'+uid))));
        allow list: if request.query.limit <= 400 && (hasAccount(uid) ||
          (signedIn() && (exists(/databases/$(database)/documents/friendships/$(uid+'--'+request.auth.uid)) ||
            exists(/databases/$(database)/documents/friendships/$(request.auth.uid+'--'+uid)))));
        allow create, update: if hasAccount(uid) && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
          request.resource.data.keys().hasOnly(['done']) && request.resource.data.done == true &&
          exists(/databases/$(database)/documents/users/$(uid)/progress/quests) &&
          day in get(/databases/$(database)/documents/users/$(uid)/progress/quests).data.days &&
          get(/databases/$(database)/documents/users/$(uid)/progress/quests).data.days[day].size() > 0;
        allow delete: if false;
      }
      match /friendRequests/{sender} {
        allow get: if hasAccount(uid) || hasAccount(sender);
        allow list: if hasAccount(uid) && request.query.limit <= 100;
        allow create: if hasAccount(sender) && uid != sender &&
          request.resource.data.keys().hasOnly(['senderUid','senderId','fid','createdAt']) &&
          request.resource.data.senderUid == sender &&
          request.resource.data.senderId == get(/databases/$(database)/documents/users/$(sender)).data.accountId &&
          request.resource.data.fid is string &&
          exists(/databases/$(database)/documents/families/$(request.resource.data.fid)/members/$(sender)) &&
          exists(/databases/$(database)/documents/families/$(request.resource.data.fid)/members/$(uid)) &&
          request.resource.data.createdAt == request.time;
        allow delete: if hasAccount(uid) || hasAccount(sender);
        allow update: if false;
      }
    }
    match /friendships/{pair} {
      allow get: if signedIn() && request.auth.uid in resource.data.members;
      allow list: if signedIn() && request.auth.uid in resource.data.members && request.query.limit <= 100;
      allow create: if hasAccount(request.resource.data.targetUid) &&
        pair == request.resource.data.senderUid+'--'+request.resource.data.targetUid &&
        request.resource.data.senderUid != request.resource.data.targetUid &&
        request.resource.data.keys().hasOnly(['senderUid','targetUid','senderId','targetId','members','acceptedAt']) &&
        request.resource.data.senderId == get(/databases/$(database)/documents/users/$(request.resource.data.senderUid)).data.accountId &&
        request.resource.data.targetId == get(/databases/$(database)/documents/users/$(request.resource.data.targetUid)).data.accountId &&
        request.resource.data.members == [request.resource.data.senderUid,request.resource.data.targetUid] &&
        exists(/databases/$(database)/documents/users/$(request.resource.data.targetUid)/friendRequests/$(request.resource.data.senderUid)) &&
        request.resource.data.acceptedAt == request.time;
      allow delete: if signedIn() && request.auth.uid in resource.data.members;
      allow update: if false;
    }
    function validMessage() {
      let d=request.resource.data;
      return d.keys().hasAll(['senderUid','senderId','text','cardId','createdAt']) &&
        d.keys().hasOnly(['senderUid','senderId','text','cardId','createdAt']) &&
        d.senderUid == request.auth.uid &&
        d.senderId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountId &&
        d.text is string && d.text.size() > 0 && d.text.size() <= 500 &&
        d.cardId is string && d.cardId.size() <= 100 && d.createdAt == request.time &&
        (d.cardId == '' ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)/progress/game) &&
           d.cardId in get(/databases/$(database)/documents/users/$(request.auth.uid)/progress/game).data.inventory &&
           get(/databases/$(database)/documents/users/$(request.auth.uid)/progress/game).data.inventory[d.cardId].copies > 0));
    }
    function validReaction(fid,messageId) {
      return !messageId.matches('^_like_.*') ||
        (messageId.matches('^_like_[A-Za-z0-9]{20}_'+request.auth.uid+'$') &&
         request.resource.data.text == '__mogumogu_like_v1__' && request.resource.data.cardId == '' &&
         exists(/databases/$(database)/documents/families/$(fid)/messages/$(messageId.split('_')[2])));
    }
    function validFamily(fid) {
      let d=request.resource.data;
      return fid.matches('^[A-Za-z0-9_-]{24}$') &&
        d.keys().hasAll(['createdBy','createdAt']) && d.keys().hasOnly(['createdBy','createdAt','name']) &&
        (!('name' in d) || d.name is string && d.name.size() > 0 && d.name.size() <= 30) &&
        d.createdBy == request.auth.uid && d.createdAt == request.time;
    }
    function validMember(uid) {
      let d=request.resource.data;
      return d.keys().hasAll(['uid','joinedAt']) && d.keys().hasOnly(['uid','joinedAt','accountId']) &&
        d.uid == uid && d.joinedAt == request.time &&
        (!('accountId' in d) || d.accountId == get(/databases/$(database)/documents/users/$(uid)).data.accountId);
    }
    match /families/{fid} {
      allow create: if hasAccount(request.auth.uid) && validFamily(fid);
      allow get: if isMember(fid);
      allow list, delete: if false;
      allow update: if isMember(fid) && (resource.data.createdBy == request.auth.uid ||
        !exists(/databases/$(database)/documents/families/$(fid)/members/$(resource.data.createdBy))) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']) &&
        request.resource.data.name is string && request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 30;
      allow update: if isMember(fid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['membershipChangedAt']) &&
        request.resource.data.membershipChangedAt == request.time;
      match /members/{uid} {
        allow get: if hasAccount(uid);
        allow create: if hasAccount(uid) && validMember(uid) &&
          exists(/databases/$(database)/documents/families/$(fid));
        allow list: if isMember(fid) && request.query.limit != null && request.query.limit <= 100;
        allow delete: if hasAccount(uid);
        allow update: if hasAccount(uid) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accountId']) &&
          request.resource.data.accountId == get(/databases/$(database)/documents/users/$(uid)).data.accountId;
      }
      match /messages/{messageId} {
        allow get: if isMember(fid);
        allow list: if isMember(fid) && request.query.limit != null && request.query.limit <= 100;
        allow create: if isMember(fid) && validMessage() && validReaction(fid,messageId);
        allow update, delete: if false;
      }
      match /activity/{activityId} {
        allow get: if isMember(fid);
        allow list: if isMember(fid) && request.query.limit <= 5000;
        allow create, update: if isMember(fid) && activityId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}_.+$') &&
          request.resource.data.keys().hasOnly(['uid','day','done']) &&
          request.resource.data.uid == request.auth.uid &&
          activityId == request.resource.data.day+'_'+request.auth.uid &&
          request.resource.data.done == true &&
          exists(/databases/$(database)/documents/users/$(request.auth.uid)/progress/quests) &&
          request.resource.data.day in get(/databases/$(database)/documents/users/$(request.auth.uid)/progress/quests).data.days &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)/progress/quests).data.days[request.resource.data.day].size() > 0;
        allow delete: if false;
      }
    }
  }
}
